<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SshKeyManager.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FA"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E7EE"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7"/>
                    <SolidColorBrush x:Key="WarnBrush" Color="#D97706"/>
                    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FEF3C7"/>
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#EFF6FF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1115"/>
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#151922"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#161A23"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#262C38"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#93A0B4"/>
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1E2430"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A5F"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B1D1D"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#14301F"/>
                    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="WarnSoftBrush" Color="#3A2A0D"/>
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#0B0E13"/>
                    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#172033"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="Border.keycard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover Border.keycard">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected Border.keycard">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.chip.warn">
            <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
        </Style>

        <Style Selector="Border.chip.warn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
        </Style>

        <Style Selector="Border.chip.accent">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>

        <Style Selector="Border.chip.accent TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Application.Styles>
</Application>
